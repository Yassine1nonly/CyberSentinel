<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">

        <TextView
            android:id="@+id/tv_index"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textColor="@color/bg_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@color/accent_cyan" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:marginLeft="12dp" android:layout_marginStart="12dp">
            <TextView android:id="@+id/tv_ip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/severity_critical" android:textSize="15sp" android:fontFamily="monospace"/>
            <TextView android:id="@+id/tv_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚠" android:textColor="@color/severity_high" android:textSize="20sp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
